{
  "data": {
    "data_kind": "backdoor_cate",
    "dgp_fn_REGISTRATION": "dgp_2",
    "n": 300,
    "dgp_kwargs": {}
  },
  "nuisances": {
    "nuisance_fn_REGISTRATION": "default",
    "nuisance_params": {
      "lam_prop": 1.0,
      "lam_outcome": 1.0,
      "clip_eps": 0.01
    }
  },
  "loss": {
    "phi_fn_REGISTRATION": "aipw",
    "phi_n_splits": 4
  },
  "omega": {
    "omega_est_REGISTRATION": "naive",
    "omega_params": {}
  },
  "prior": {
    "prior_mu": 0.0,
    "prior_sigma": 1.0,
    "prior_lengthscale": 1.0,
    "prior_variance": 1.0
  },
  "var_family": {
    "q_family_cls_REGISTRATION": "inducing_gp",
    "q_family_kwargs": {
      "M": 20,
      "kernel": "matern52",
      "lengthscale": 2.0,
      "variance": 2.0,
      "rq_alpha": 1.0,
      "mean_type": "constant",
      "mean_alpha": 0.001,
      "jitter": 1e-04
    }
  },
  "learning": {
    "learn_cfg": {
      "batch_size": 200,
      "n_epochs": 2000,
      "lr": 0.03,
      "track_grads": true
    }
  },
  "analytic": {
    "analytic_flag": true
  },
  "misc": {
    "run_seed": 42,
    "device": "cpu",
    "log": true,
    "plot": false,
    "progress": true,
    "diagnostics": true,
    "cate_eval": {
      "grid": {
        "n": 120,
        "dim": 0
      }
    }
  }
}
